# apps/autopost/.env.local 로 복사해서 채운다. (서버 전용 값은 NEXT_PUBLIC_ 금지)

# Supabase — 로그인·스토리지
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres 직접 연결(autopost 스키마). Supabase 풀러(포트 6543) 주소 권장.
DATABASE_URL=

# cron 보호용 임의 문자열. Vercel 프로젝트 환경변수에도 같은 값을 넣으면 Vercel Cron 이 자동으로 붙인다.
CRON_SECRET=

# Meta(Instagram·Facebook) — 있으면 짧은 토큰을 60일 장기 토큰으로 바꿔 저장한다.
META_APP_ID=
META_APP_SECRET=
# Threads — 있으면 장기 토큰으로 교환.
THREADS_APP_SECRET=

# X — OAuth 2.0 앱. refresh token 자동 갱신에 필요.
X_CLIENT_ID=
X_CLIENT_SECRET=

# TikTok — Content Posting API 앱. refresh token 자동 갱신에 필요.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
